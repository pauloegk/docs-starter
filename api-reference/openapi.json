{
  "openapi": "3.0.0",
  "info": {
    "title": "API Manybot",
    "description": "",
    "version": "v1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "https://api-v2.manybot.com.br"
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ],
  "paths": {
    "/messages/send-text": {
      "post": {
        "operationId": "MessageController_sendTextMessage",
        "parameters": [],
        "requestBody": {
          "required": true,
          "description": "Dados para enviar uma mensagem de texto",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendTextRequestDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "tags": ["Messages"]
      }
    },
    "/messages/send-media": {
      "post": {
        "operationId": "MessageController_sendMediaMessage",
        "parameters": [],
        "requestBody": {
          "required": true,
          "description": "Dados para enviar uma mensagem de mídia via URL",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendMediaRequestDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "tags": ["Messages"]
      }
    },
    "/messages/send-audio": {
      "post": {
        "operationId": "MessageController_sendAudioMessage",
        "parameters": [],
        "requestBody": {
          "required": true,
          "description": "Dados para enviar uma mensagem de áudio via URL",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendAudioRequestDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "tags": ["Messages"]
      }
    },
    "/messages/send-template": {
      "post": {
        "operationId": "MessageController_sendTemplateMessage",
        "summary": "Enviar template de mensagem",
        "description": "Envia um template aprovado na Meta. O backend busca a estrutura do template automaticamente e monta os parâmetros (components) a partir dos valores informados.",
        "parameters": [],
        "requestBody": {
          "required": true,
          "description": "Dados para enviar um template de mensagem aprovado na Meta",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendTemplateRequestDto"
              },
              "examples": {
                "Named params (variáveis nomeadas)": {
                  "summary": "Template com variáveis nomeadas",
                  "description": "Usa nomes de variáveis como contact_first_name, contact_email, etc.",
                  "value": {
                    "channelId": "clh1234567890",
                    "phone": "+5511999999999",
                    "templateName": "confirmacao_pedido",
                    "language": "pt_BR",
                    "params": {
                      "contact_first_name": "João",
                      "contact_email": "joao@email.com"
                    }
                  }
                },
                "Positional params (variáveis posicionais)": {
                  "summary": "Template com variáveis posicionais",
                  "description": "Usa índices numéricos \"1\", \"2\", \"3\" como chave dos parâmetros.",
                  "value": {
                    "channelId": "clh1234567890",
                    "phone": "+5511999999999",
                    "templateName": "status_pedido",
                    "language": "pt_BR",
                    "params": {
                      "1": "João",
                      "2": "12345",
                      "3": "Enviado"
                    }
                  }
                },
                "Header de imagem": {
                  "summary": "Template com header de imagem",
                  "description": "Envia um template que possui header do tipo IMAGE com a URL da imagem.",
                  "value": {
                    "channelId": "clh1234567890",
                    "phone": "+5511999999999",
                    "templateName": "promo_banner",
                    "language": "pt_BR",
                    "params": {
                      "contact_first_name": "Maria"
                    },
                    "header": {
                      "imageUrl": "https://cdn.seudominio.com/banner.jpg"
                    }
                  }
                },
                "Header de vídeo": {
                  "summary": "Template com header de vídeo",
                  "description": "Envia um template que possui header do tipo VIDEO com a URL do vídeo.",
                  "value": {
                    "channelId": "clh1234567890",
                    "phone": "+5511999999999",
                    "templateName": "tutorial_produto",
                    "language": "pt_BR",
                    "params": {
                      "contact_first_name": "Carlos"
                    },
                    "header": {
                      "videoUrl": "https://cdn.seudominio.com/tutorial.mp4"
                    }
                  }
                },
                "Header de documento": {
                  "summary": "Template com header de documento",
                  "description": "Envia um template que possui header do tipo DOCUMENT com URL e nome do arquivo.",
                  "value": {
                    "channelId": "clh1234567890",
                    "phone": "+5511999999999",
                    "templateName": "envio_contrato",
                    "language": "pt_BR",
                    "params": {
                      "contact_first_name": "Ana"
                    },
                    "header": {
                      "documentUrl": "https://cdn.seudominio.com/contrato.pdf",
                      "documentFilename": "contrato.pdf"
                    }
                  }
                },
                "Botão de URL dinâmico": {
                  "summary": "Template com botão de URL dinâmico",
                  "description": "Usa button_url_0 para preencher o sufixo dinâmico do botão de URL do template.",
                  "value": {
                    "channelId": "clh1234567890",
                    "phone": "+5511999999999",
                    "templateName": "rastreio_pedido",
                    "language": "pt_BR",
                    "params": {
                      "contact_first_name": "Pedro",
                      "button_url_0": "pedido/12345"
                    }
                  }
                },
                "Sem parâmetros": {
                  "summary": "Template sem variáveis",
                  "description": "Template simples que não possui variáveis no body nem header de mídia.",
                  "value": {
                    "channelId": "clh1234567890",
                    "phone": "+5511999999999",
                    "templateName": "boas_vindas",
                    "language": "pt_BR"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Template enviado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendTemplateResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Template não está aprovado ou dados inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "number",
                      "example": 400
                    },
                    "message": {
                      "type": "string",
                      "example": "Template \"meu_template\" não está aprovado (status: REJECTED)"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Template não encontrado na Meta",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "number",
                      "example": 404
                    },
                    "message": {
                      "type": "string",
                      "example": "Template \"meu_template\" (pt_BR) não encontrado"
                    }
                  }
                }
              }
            }
          }
        },
        "tags": ["Messages"]
      }
    },
    "/channels": {
      "get": {
        "operationId": "ChannelsController_findAllByCompany",
        "summary": "List channels",
        "description": "Retorna todos os canais da empresa.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Lista de canais retornada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ChannelResponseDTO"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Não autorizado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "number",
                      "example": 401
                    },
                    "message": {
                      "type": "string",
                      "example": "Unauthorized"
                    }
                  }
                }
              }
            }
          }
        },
        "tags": ["Channels"]
      }
    },
    "/channels/connect-whatsapp": {
      "post": {
        "operationId": "ChannelsController_connect",
        "summary": "Conectar canal WhatsApp",
        "description": "Conecta um novo canal WhatsApp à empresa.",
        "parameters": [],
        "requestBody": {
          "required": true,
          "description": "Dados para conectar o canal WhatsApp, caso não passe o phone, será gerado um QR Code para conexão.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConnectWhatsappDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Canal WhatsApp conectado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChannelResponseDTO"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos fornecidos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "number",
                      "example": 400
                    },
                    "message": {
                      "type": "string",
                      "example": "Invalid phone number format"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Canal já existe para este número",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "number",
                      "example": 409
                    },
                    "message": {
                      "type": "string",
                      "example": "Channel already exists for this phone number"
                    }
                  }
                }
              }
            }
          }
        },
        "tags": ["Channels"]
      }
    },
    "/channels/{id}": {
      "delete": {
        "operationId": "ChannelsController_disconnected",
        "summary": "Desconectar canal",
        "description": "Desconecta um canal específico da empresa.",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "ID único do canal a ser desconectado",
            "schema": {
              "example": "clh1234567890",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Canal desconectado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChannelResponseDTO"
                }
              }
            }
          },
          "401": {
            "description": "Não autorizado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "number",
                      "example": 401
                    },
                    "message": {
                      "type": "string",
                      "example": "Unauthorized"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Canal não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "number",
                      "example": 404
                    },
                    "message": {
                      "type": "string",
                      "example": "Channel not found"
                    }
                  }
                }
              }
            }
          }
        },
        "tags": ["Channels"]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token JWT da sua conta. Use o formato: Bearer {seu-jwt-token}"
      }
    },
    "schemas": {
      "SendTextRequestDto": {
        "type": "object",
        "properties": {
          "channelId": {
            "type": "string",
            "description": "ID do canal conectado",
            "example": "clh1234567890"
          },
          "message": {
            "type": "string",
            "description": "Mensagem a ser enviada",
            "example": "Olá, como vai?"
          },
          "phone": {
            "type": "string",
            "description": "Número do destinatário (formato internacional)",
            "example": "+5511999999999"
          }
        },
        "required": ["channelId", "message", "phone"]
      },
      "SendMediaRequestDto": {
        "type": "object",
        "properties": {
          "channelId": {
            "type": "string",
            "description": "ID do canal conectado",
            "example": "clh1234567890"
          },
          "phone": {
            "type": "string",
            "description": "Número do destinatário (formato internacional)",
            "example": "+5511999999999"
          },
          "mediaUrl": {
            "type": "string",
            "description": "URL pública do arquivo de mídia (não é upload)",
            "example": "https://cdn.seudominio.com/arquivo.jpg"
          },
          "mediatype": {
            "type": "string",
            "description": "Tipo da mídia",
            "enum": ["image", "document", "video"],
            "example": "image"
          },
          "caption": {
            "type": "string",
            "description": "Legenda opcional da mídia",
            "example": "Segue o catálogo atualizado"
          },
          "fileName": {
            "type": "string",
            "description": "Nome do arquivo (recomendado para document)",
            "example": "catalogo.pdf"
          },
          "mimetype": {
            "type": "string",
            "description": "MIME type (ex: image/jpeg, application/pdf)",
            "example": "image/jpeg"
          }
        },
        "required": ["channelId", "phone", "mediaUrl", "mediatype"]
      },
      "SendAudioRequestDto": {
        "type": "object",
        "properties": {
          "channelId": {
            "type": "string",
            "description": "ID do canal conectado",
            "example": "clh1234567890"
          },
          "phone": {
            "type": "string",
            "description": "Número do destinatário (formato internacional)",
            "example": "+5511999999999"
          },
          "audioUrl": {
            "type": "string",
            "description": "URL pública do áudio (será baixado e enviado)",
            "example": "https://cdn.seudominio.com/audio.mp3"
          }
        },
        "required": ["channelId", "phone", "audioUrl"]
      },
      "QrCodeInterface": {
        "type": "object",
        "properties": {
          "base64": {
            "type": "string",
            "description": "QR Code em base64",
            "example": "iVBORw0KGgoAAAANSUhEUgAA..."
          }
        },
        "required": ["base64"]
      },
      "ChannelResponseDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ID único do canal",
            "example": "clh1234567890"
          },
          "name": {
            "type": "string",
            "description": "Nome do canal",
            "example": "Canal WhatsApp Principal"
          },
          "companyId": {
            "type": "string",
            "description": "ID da empresa proprietária do canal",
            "example": "clh9876543210"
          },
          "connectionStatus": {
            "type": "string",
            "description": "Status da conexão do canal",
            "example": "connected",
            "enum": ["open", "close", "connecting", "refused", "qrcode_limit_scan"]
          },
          "type": {
            "type": "string",
            "description": "Tipo do canal",
            "example": "whatsapp",
            "enum": ["whatsapp", "telegram", "instagram"]
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "description": "Data de criação do canal",
            "example": "2024-01-15T10:30:00Z"
          },
          "phone": {
            "type": "string",
            "description": "Número do telefone conectado",
            "example": "+5511999999999"
          },
          "qrcode": {
            "description": "QR Code para conexão",
            "allOf": [
              {
                "$ref": "#/components/schemas/QrCodeInterface"
              }
            ]
          },
          "paircode": {
            "type": "string",
            "description": "Código de pareamento",
            "example": "ABC123XYZ"
          }
        },
        "required": ["id", "companyId", "connectionStatus", "type", "createdAt"]
      },
      "SendTemplateRequestDto": {
        "type": "object",
        "properties": {
          "channelId": {
            "type": "string",
            "description": "ID do canal para envio.",
            "example": "clh1234567890"
          },
          "phone": {
            "type": "string",
            "description": "Número do destinatário (formato internacional).",
            "example": "+5511999999999"
          },
          "templateName": {
            "type": "string",
            "description": "Nome do template aprovado na Meta.",
            "example": "confirmacao_pedido"
          },
          "language": {
            "type": "string",
            "description": "Código do idioma do template (ex: pt_BR, en_US, es_AR). Normalmente use `pt_BR`.",
            "default": "pt_BR",
            "example": "pt_BR"
          },
          "params": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Parâmetros de variáveis do template. Chave = nome da variável (ex: contact_first_name), valor = texto. Para templates posicionais use \"1\", \"2\", etc. Para botões de URL dinâmico use \"button_url_0\", \"button_url_1\", etc.",
            "example": {
              "contact_first_name": "João",
              "contact_email": "joao@email.com"
            }
          },
          "header": {
            "description": "Mídia do header do template. Informe apenas um dos campos: imageUrl, videoUrl ou documentUrl.",
            "$ref": "#/components/schemas/TemplateHeaderDto"
          }
        },
        "required": ["channelId", "phone", "templateName", "language"]
      },
      "TemplateHeaderDto": {
        "type": "object",
        "description": "Mídia do header do template. Informe apenas um dos campos: imageUrl, videoUrl ou documentUrl.",
        "properties": {
          "imageUrl": {
            "type": "string",
            "description": "URL da imagem para templates com header de imagem.",
            "example": "https://cdn.seudominio.com/banner.jpg"
          },
          "videoUrl": {
            "type": "string",
            "description": "URL do vídeo para templates com header de vídeo.",
            "example": "https://cdn.seudominio.com/video.mp4"
          },
          "documentUrl": {
            "type": "string",
            "description": "URL do documento para templates com header de documento.",
            "example": "https://cdn.seudominio.com/contrato.pdf"
          },
          "documentFilename": {
            "type": "string",
            "description": "Nome do arquivo para header de documento (opcional, usado junto com documentUrl).",
            "example": "contrato.pdf"
          }
        }
      },
      "SendTemplateResponseDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Indica se o envio foi bem-sucedido.",
            "example": true
          },
          "chatId": {
            "type": "string",
            "description": "ID interno do chat.",
            "example": "clh0987654321"
          },
          "externalChatId": {
            "type": "string",
            "description": "ID externo do chat (número do WhatsApp).",
            "example": "5511999999999@s.whatsapp.net"
          },
          "wamid": {
            "type": "string",
            "description": "WhatsApp Message ID retornado pela Meta.",
            "example": "wamid.HBgNNTUxMTk5OTk5OTk5FQIAERgSQjYxNzc2..."
          },
          "message": {
            "type": "string",
            "description": "Mensagem de confirmação.",
            "example": "Template enviado com sucesso"
          }
        },
        "required": ["success", "chatId", "externalChatId", "message"]
      },
      "ConnectWhatsappDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "description": "Número do telefone para conectar ao WhatsApp",
            "example": "+5511999999999"
          }
        }
      }
    }
  }
}