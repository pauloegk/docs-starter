          },
          "409": {
            "description": "Canal já existe para este número",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "number",
                      "example": 409
                    },
                    "message": {
                      "type": "string",
                      "example": "Channel already exists for this phone number"
                    }
                  }
                }
              }
            }
          }
        },
        "tags": [
          "Channels"
        ]
      }
    },
