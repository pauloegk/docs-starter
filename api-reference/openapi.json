        "tags": [
          "Channels"
        ]
      }
    },
    "/messages/send-flow": {
      "post": {
        "operationId": "sendFlow",
        "summary": "Enviar Flow",
        "description": "Envia um WhatsApp Flow diretamente (mensagem interativa). Para disparo proativo fora da janela de 24h, use send-template com um template que tenha botão de Flow.",
        "parameters": [
          {
            "name": "X-Request-Id",
            "in": "header",
            "required": false,
            "description": "Chave de idempotência gerada pelo integrador para evitar disparo duplicado da mesma mensagem em caso de retry. Gere um UUID por mensagem lógica e reenvie o mesmo valor se precisar repetir a requisição. A chave é única por canal (`channelId`). Se não for um UUID válido, a API responde 400 (`key: \"invalid_request_id\"`). Se omitido, não há deduplicação.",
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "11111111-1111-4111-8111-111111111111"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "description": "Dados para enviar um WhatsApp Flow",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendFlowRequestDto"
              },
              "examples": {
                "Flow com dados": {
                  "summary": "Flow com flowData",
                  "value": {
                    "channelId": "clh1234567890",
                    "phone": "+5511999999999",
                    "flowId": "123456789012345",
                    "body": "Toque para escolher seu horário",
                    "flowCta": "Agendar",
                    "screen": "AGENDAMENTO",
                    "flowData": {
                      "agendamentoId": "AG-1024",
                      "nome": "Maria"
                    },
                    "metadata": {
                      "agendamentoId": "AG-1024",
                      "clienteId": "c_789"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Replay: uma requisição com o mesmo `X-Request-Id` já foi processada com sucesso neste canal. A mensagem não é reenviada e a resposta traz o mesmo resultado da primeira vez (mesmo `wamid`, `chatId` etc.).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendTemplateResponseDto"
                }
              }
            }
          },
          "201": {
            "description": "Template enviado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendTemplateResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Template não está aprovado ou dados inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "number",
                      "example": 400
                    },
                    "message": {
                      "type": "string",
                      "example": "Template \"meu_template\" não está aprovado (status: REJECTED)"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Template não encontrado na Meta",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "number",
                      "example": 404
                    },
                    "message": {
                      "type": "string",
                      "example": "Template \"meu_template\" (pt_BR) não encontrado"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Já existe uma requisição com o mesmo `X-Request-Id` em processamento neste canal. Tente novamente em instantes.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "number",
                      "example": 409
                    },
                    "error": {
                      "type": "string",
                      "example": "request_in_progress"
                    }
                  }
                }
              }
            }
          }
        },
        "tags": [
          "Messages"
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token JWT da sua conta. Use o formato: Bearer {seu-jwt-token}"
      }
    },
    "schemas": {
      "SendTextRequestDto": {
        "type": "object",
        "properties": {
          "channelId": {
            "type": "string",
            "description": "ID do canal conectado",
            "example": "clh1234567890"
          },
          "message": {
            "type": "string",
            "description": "Mensagem a ser enviada",
            "example": "Olá, como vai?"
          },
          "phone": {
            "type": "string",
            "description": "Número do destinatário (formato internacional)",
            "example": "+5511999999999"
          }
        },
        "required": [
          "channelId",
          "message",
          "phone"
        ]
      },
      "SendMediaRequestDto": {
        "type": "object",
        "properties": {
          "channelId": {
            "type": "string",
            "description": "ID do canal conectado",
            "example": "clh1234567890"
          },
          "phone": {
            "type": "string",
            "description": "Número do destinatário (formato internacional)",
            "example": "+5511999999999"
          },
          "mediaUrl": {
            "type": "string",
            "description": "URL pública do arquivo de mídia (não é upload)",
            "example": "https://cdn.seudominio.com/arquivo.jpg"
          },
          "mediatype": {
            "type": "string",
            "description": "Tipo da mídia",
            "enum": [
              "image",
              "document",
              "video"
            ],
            "example": "image"
          },
          "caption": {
            "type": "string",
            "description": "Legenda opcional da mídia",
            "example": "Segue o catálogo atualizado"
          },
          "fileName": {
            "type": "string",
            "description": "Nome do arquivo (recomendado para document)",
            "example": "catalogo.pdf"
          },
          "mimetype": {
            "type": "string",
            "description": "MIME type (ex: image/jpeg, application/pdf)",
            "example": "image/jpeg"
          }
        },
        "required": [
          "channelId",
          "phone",
          "mediaUrl",
          "mediatype"
        ]
      },
      "SendAudioRequestDto": {
        "type": "object",
        "properties": {
          "channelId": {
            "type": "string",
            "description": "ID do canal conectado",
            "example": "clh1234567890"
          },
          "phone": {
            "type": "string",
            "description": "Número do destinatário (formato internacional)",
            "example": "+5511999999999"
          },
          "audioUrl": {
            "type": "string",
            "description": "URL pública do áudio (será baixado e enviado)",
            "example": "https://cdn.seudominio.com/audio.mp3"
          }
        },
        "required": [
          "channelId",
          "phone",
          "audioUrl"
        ]
      },
      "QrCodeInterface": {
        "type": "object",
        "properties": {
          "base64": {
            "type": "string",
            "description": "QR Code em base64",
            "example": "iVBORw0KGgoAAAANSUhEUgAA..."
          }
        },
        "required": [
          "base64"
        ]
      },
      "ChannelResponseDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ID único do canal",
            "example": "clh1234567890"
          },
          "name": {
            "type": "string",
            "description": "Nome do canal",
            "example": "Canal WhatsApp Principal"
          },
          "companyId": {
            "type": "string",
            "description": "ID da empresa proprietária do canal",
            "example": "clh9876543210"
          },
          "connectionStatus": {
            "type": "string",
            "description": "Status da conexão do canal",
            "example": "connected",
            "enum": [
              "open",
              "close",
              "connecting",
              "refused",
              "qrcode_limit_scan"
            ]
          },
          "type": {
            "type": "string",
            "description": "Tipo do canal",
            "example": "whatsapp",
            "enum": [
              "whatsapp",
              "telegram",
              "instagram"
            ]
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "description": "Data de criação do canal",
            "example": "2024-01-15T10:30:00Z"
          },
          "phone": {
            "type": "string",
            "description": "Número do telefone conectado",
            "example": "+5511999999999"
          },
          "qrcode": {
            "description": "QR Code para conexão",
            "allOf": [
              {
                "$ref": "#/components/schemas/QrCodeInterface"
              }
            ]
          },
          "paircode": {
            "type": "string",
            "description": "Código de pareamento",
            "example": "ABC123XYZ"
          }
        },
        "required": [
          "id",
          "companyId",
          "connectionStatus",
          "type",
          "createdAt"
        ]
      },
      "SendTemplateRequestDto": {
        "type": "object",
        "properties": {
          "channelId": {
            "type": "string",
            "description": "ID do canal para envio.",
            "example": "clh1234567890"
          },
          "phone": {
            "type": "string",
            "description": "Número do destinatário (formato internacional).",
            "example": "+5511999999999"
          },
          "templateName": {
            "type": "string",
            "description": "Nome do template aprovado na Meta.",
            "example": "confirmacao_pedido"
          },
          "language": {
            "type": "string",
            "description": "Código do idioma do template (ex: pt_BR, en_US, es_AR). Normalmente use `pt_BR`.",
            "default": "pt_BR",
            "example": "pt_BR"
          },
          "params": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Parâmetros de variáveis do template. Chave = nome da variável (ex: contact_first_name), valor = texto. Para templates posicionais use \"1\", \"2\", etc. Para botões de URL dinâmico use \"button_url_0\", \"button_url_1\", etc.",
            "example": {
              "contact_first_name": "João",
              "contact_email": "joao@email.com"
            }
          },
          "header": {
            "description": "Mídia do header do template. Informe apenas um dos campos: imageUrl, videoUrl ou documentUrl.",
            "$ref": "#/components/schemas/TemplateHeaderDto"
          },
          "flowData": {
            "type": "object",
            "additionalProperties": true,
            "description": "Dados iniciais do flow quando o template tem um botão de Flow. Alimentam a 1ª tela do flow (referenciados via ${data.campo}). Use para disparar um WhatsApp Flow de forma proativa via template.",
            "example": {
              "agendamentoId": "AG-1024",
              "nome": "Maria",
              "servico": "Consulta de rotina"
            }
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true,
            "description": "Metadados livres do integrador, gravados na mensagem para controle/consulta posterior (ex.: id do pedido, id do cliente).",
            "example": {
              "pedidoId": "PED-5521",
              "clienteId": "c_789"
            }
          }
        },
        "required": [
          "channelId",
          "phone",
          "templateName",
          "language"
        ]
      },
      "TemplateHeaderDto": {
        "type": "object",
        "description": "Mídia do header do template. Informe apenas um dos campos: imageUrl, videoUrl ou documentUrl.",
        "properties": {
          "imageUrl": {
            "type": "string",
            "description": "URL da imagem para templates com header de imagem.",
            "example": "https://cdn.seudominio.com/banner.jpg"
          },
          "videoUrl": {
            "type": "string",
            "description": "URL do vídeo para templates com header de vídeo.",
            "example": "https://cdn.seudominio.com/video.mp4"
          },
          "documentUrl": {
            "type": "string",
            "description": "URL do documento para templates com header de documento.",
            "example": "https://cdn.seudominio.com/contrato.pdf"
          },
          "documentFilename": {
            "type": "string",
            "description": "Nome do arquivo para header de documento (opcional, usado junto com documentUrl).",
            "example": "contrato.pdf"
          }
        }
      },
      "SendTemplateResponseDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Indica se o envio foi bem-sucedido.",
            "example": true
          },
          "chatId": {
            "type": "string",
            "description": "ID interno do chat.",
            "example": "clh0987654321"
          },
          "externalChatId": {
            "type": "string",
            "description": "ID externo do chat (número do WhatsApp).",
            "example": "5511999999999@s.whatsapp.net"
          },
          "wamid": {
            "type": "string",
            "description": "WhatsApp Message ID retornado pela Meta.",
            "example": "wamid.HBgNNTUxMTk5OTk5OTk5FQIAERgSQjYxNzc2..."
          },
          "message": {
            "type": "string",
            "description": "Mensagem de confirmação.",
            "example": "Template enviado com sucesso"
          }
        },
        "required": [
          "success",
          "chatId",
          "externalChatId",
          "message"
        ]
      },
      "ConnectWhatsappDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "description": "Número do telefone para conectar ao WhatsApp",
            "example": "+5511999999999"
          }
        }
      },
      "SendFlowRequestDto": {
        "type": "object",
        "properties": {
          "channelId": {
            "type": "string",
            "description": "ID do canal para envio.",
            "example": "clh1234567890"
          },
          "phone": {
            "type": "string",
            "description": "Número do destinatário (formato internacional).",
            "example": "+5511999999999"
          },
          "flowId": {
            "type": "string",
            "description": "ID do WhatsApp Flow a enviar.",
            "example": "123456789012345"
          },
          "body": {
            "type": "string",
            "description": "Texto do corpo da mensagem que acompanha o botão do flow.",
            "example": "Toque para escolher seu horário"
          },
          "flowCta": {
            "type": "string",
            "description": "Rótulo do botão que abre o flow (CTA). Recomendado < 30 caracteres.",
            "example": "Agendar"
          },
          "screen": {
            "type": "string",
            "description": "Tela inicial do flow. Obrigatória quando enviar flowData.",
            "example": "AGENDAMENTO"
          },
          "flowData": {
            "type": "object",
            "additionalProperties": true,
            "description": "Dados iniciais para pré-preencher a 1ª tela (referenciados via ${data.campo}).",
            "example": {
              "agendamentoId": "AG-1024",
              "nome": "Maria"
            }
          },
          "mode": {
            "type": "string",
            "enum": [
              "draft",
              "published"
            ],
            "description": "draft (teste) ou published (padrão).",
            "example": "published"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true,
            "description": "Metadados livres gravados na mensagem (ex.: id do pedido, id do cliente).",
            "example": {
              "pedidoId": "PED-5521",
              "clienteId": "c_789"
            }
          }
        },
        "required": [
          "channelId",
          "phone",
          "flowId",
          "body",
          "flowCta"
        ]
      }
    }
  }
}